# ============================================================
# TemplaFill .gitignore
# ⚠️  THIS REPO IS PUBLIC — be extra careful about secrets!
# ============================================================

# ----- Environment Variables (CRITICAL — contains API keys) -----
.env
.env.local
.env.development
.env.staging
.env.production
.env.*.local
# .env.example is SAFE to commit (contains placeholder values only)

# ----- User Uploaded Documents (CONFIDENTIAL) -----
uploads/
temp/
tmp/

# ----- Evaluation Data (may contain real documents / PII) -----
# The eval runner script (run_eval.py) IS safe to commit
# But actual test PDFs and extraction results may contain sensitive data
eval/datasets/**/*.pdf
eval/datasets/**/*.docx
eval/datasets/**/*.xlsx
eval/datasets/**/*.pptx
eval/results/

# ----- Python -----
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ----- Node.js -----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ----- IDE & Editor -----
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- Build Artifacts -----
*.sqlite3
*.db

# ----- Docker -----
# docker-compose.yml is SAFE (uses env vars)
# But local docker data volumes should not be committed
docker-data/

# ----- Misc -----
*.bak
*.backup
*.orig
