# ============================================================
# TemplaFill Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- Application -----
APP_ENV=development                    # development | staging | production
APP_NAME=TemplaFill
APP_VERSION=0.1.0
DEBUG=true

# ----- Backend Server -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000     # Comma-separated allowed origins

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=TemplaFill

# ----- Database (Free-forever: Supabase 500MB pgvector, not Render 30-day) -----
# Local:  postgresql+asyncpg://postgres:postgres@localhost:5432/templafill
# Supabase prod: postgresql+asyncpg://postgres.[project]:[pass]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/templafill
DATABASE_ECHO=false                    # Set true to log SQL queries

# ----- Redis (Upstash 10k/day or in-memory fallback for Hobby) -----
REDIS_URL=redis://localhost:6379/0

# ----- Gemini API -----
GEMINI_API_KEY=your_gemini_api_key_here    # Get from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.7-flash             # Model for extraction (Gemini 3.7 Flash)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001  # Model for embeddings (gemini-embedding-001)

# ----- File Storage -----
UPLOAD_DIR=./uploads                   # Local upload directory
MAX_SOURCE_FILE_SIZE_MB=50             # Max source PDF size
MAX_TEMPLATE_FILE_SIZE_MB=20           # Max template file size
MAX_SOURCE_PAGES=500                   # Max PDF pages
FILE_RETENTION_HOURS=24                # Auto-delete after this many hours

# ----- Security -----
# SECRET_KEY signs per-job session tokens. Must be a strong random value in production.
SECRET_KEY=change_this_to_a_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TOKEN_EXPIRE_HOURS=24           # Lifetime of a per-job access token

# ----- Access control / proxies (security hardening) -----
# Require the per-job session token on /api/jobs/* (do NOT disable in production)
REQUIRE_SESSION_TOKEN=true
# Cross-site (Vercel) session cookie settings; token is also returned in the upload response
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
# Comma-separated trusted proxy IPs/CIDRs allowed to set X-Forwarded-For (e.g. Render/Cloudflare)
TRUSTED_PROXIES=

# ----- Resource limits (DoS protection) -----
MAX_REQUEST_BODY_MB=90                  # Hard cap for the whole multipart upload body
MAX_CONCURRENT_JOBS=100                 # Max retained in-memory jobs before eviction
MAX_TEMPLATE_UNCOMPRESSED_MB=500        # ZIP-bomb guard: max decompressed template size
MAX_TEMPLATE_ZIP_RATIO=100              # ZIP-bomb guard: max uncompressed/compressed ratio

# ----- Rate Limiting -----
RATE_LIMIT_UPLOAD=10/hour              # Upload endpoint limit
RATE_LIMIT_API_READ=60/minute          # Read endpoint limit
RATE_LIMIT_API_WRITE=30/minute         # Write endpoint limit

# ----- RAG Pipeline -----
CHUNK_SIZE=800                         # Tokens per chunk
CHUNK_OVERLAP=100                      # Overlap between chunks
RAG_TOP_K=5                            # Number of chunks to retrieve per field
EMBEDDING_BATCH_SIZE=100               # Chunks per embedding API call

# ----- Tier system — account tier (Phase 6, ADR-020) -----
# Login is DISABLED until TIER_ACCOUNT_PASSWORD_HASH is set (503 otherwise).
# Generate the hash:  python scripts/hash_password.py
TIER_ACCOUNT_USERNAME=account
TIER_ACCOUNT_PASSWORD_HASH=            # scrypt$<salt_hex>$<hash_hex> — never commit the plaintext password
TIER_TOKEN_EXPIRE_DAYS=30              # Signed account-tier token lifetime
# Daily per-IP upload quotas (429 QUOTA_EXCEEDED when exceeded)
FREE_JOBS_PER_DAY=5                    # Free tier (Gemini) uploads per IP per day
PRO_JOBS_PER_DAY=50                    # Account tier (DeepSeek) uploads per IP per day — cost guard

# ----- DeepSeek API (account tier — zero Google calls, ADR-020) -----
DEEPSEEK_API_KEY=                      # https://platform.deepseek.com — unset = account tier runs heuristic-only
DEEPSEEK_MODEL=deepseek-flash          # Model id (config-only, so renames never need code changes)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_BATCH_CHARS=240000        # Max document chars per sequential batch (RAG is bypassed on this tier)
